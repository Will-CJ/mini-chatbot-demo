# Copy to .env for local runs. On Hugging Face, add these as Space secrets instead.
LLM_API_KEY=your-api-key
# Gemini (default). For OpenAI: https://api.openai.com/v1  For Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
ADMIN_TOKEN=pick-a-long-random-string
CONTACT_URL=https://www.placidway.com
